    "weapon_rack": {"sheet": "element", "x": 11, "y": 2, "w": 3, "h": 2, "over_rows": 0},
    "dummy": {"sheet": "element", "x": 15, "y": 0, "w": 1, "h": 1, "over_rows": 0},
    "sage_statue": {"sheet": "house", "x": 3, "y": 15, "w": 2, "h": 2, "over_rows": 1, "about": "a seated figure holding the water-blue pearl"},
    "torii": {"sheet": "house", "x": 0, "y": 5, "w": 3, "h": 2, "over_rows": 2, "collide": false, "about": "the sect gate; walkers pass under it"},
    "banner_1": {"sheet": "house", "x": 22, "y": 20, "w": 1, "h": 2, "over_rows": 0},
    "banner_2": {"sheet": "house", "x": 23, "y": 20, "w": 1, "h": 2, "over_rows": 0},
    "banner_3": {"sheet": "house", "x": 24, "y": 20, "w": 1, "h": 2, "over_rows": 0},
    "banner_4": {"sheet": "house", "x": 25, "y": 20, "w": 1, "h": 2, "over_rows": 0},
    "banner_5": {"sheet": "house", "x": 26, "y": 20, "w": 1, "h": 2, "over_rows": 0},
    "banner_6": {"sheet": "house", "x": 27, "y": 20, "w": 1, "h": 2, "over_rows": 0, "recolor": "house_banner_violet"},
    "mote": {"sheet": "motes", "x": 0, "y": 0, "w": 1, "h": 1, "over_rows": 1, "about": "a spirit, a small water-teal light drawn by gen_sect.py, not from the pack"},
    "mote_well": {"sheet": "house", "x": 3, "y": 15, "w": 2, "h": 2, "over_rows": 1, "about": "placeholder rim, replaced by a drawn well when the WizardGenie tiles land"},
    "master_yun": {"sheet": "yun", "x": 0, "y": 0, "w": 1, "h": 1, "over_rows": 0}
  },
  "plaque": {
    "about": "Room names are drawn into a signs tileset as wooden plaques, so a player reads the name in the world itself. Plaques sit on the wall beside the door.",
    "font": "/usr/share/fonts/truetype/dejavu/DejaVuSans-Bold.ttf",
    "px": 9,
    "wood": "#6b3e26", "edge": "#2a1a10", "ink": "#f3e2c0"
  },
  "rules": {
    "about": "Walkable-scale rules proven on the Oddboro office round (odb-ladder-look-2): WorkAdventure v1.35 walker feet are 16x16. Meeting rooms are 30% above that round's 10x9 minimum (his note on odb-ladder-look-2).",
    "corridor_min": 3,
    "door_min": 2,
    "clear_round_npc": 2,
    "room_min_interior": [12, 10],
    "doors_on": "north or south walls only, so every plaque has a wall row to sit on"
  },
  "room_kinds": {
    "about": "The room grammar. Each kind names its wall, floor and furniture plan; the level gives the seat count.",
    "assembly": {"wall": "orange", "floor": "boards_tan", "plan": "rows facing a dais", "meeting": true},
    "circle":   {"wall": "tan", "floor": "brick_pale", "plan": "one low table, seats round it, the School's banner on the north wall", "meeting": true},
    "dojo":     {"wall": "tan", "floor": "boards_tan", "plan": "sparring medallion, six stance panels, seats round the floor", "meeting": true},
    "tea":      {"wall": "green", "floor": "boards_green", "plan": "tea tables with a seat each side, shelves on the north wall", "meeting": true},
    "shrine":   {"wall": "brown", "floor": "stone_dark", "plan": "a seated figure, an altar table, two seats", "meeting": false},
    "mote_well": {"wall": "green", "floor": "boards_green", "plan": "a well at the centre on dark stone, motes above it, six seats round it, the ladder plate on the north wall", "meeting": true},
    "court":    {"wall": null, "floor": "paving", "plan": "open paving, standing room, gate and notice board", "meeting": false}
  }
}
