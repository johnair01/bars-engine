    "tea_table": {"sheet": "element", "x": 3, "y": 9, "w": 1, "h": 1, "over_rows": 0},
    "altar_table": {"sheet": "element", "x": 9, "y": 9, "w": 2, "h": 1, "over_rows": 0},
