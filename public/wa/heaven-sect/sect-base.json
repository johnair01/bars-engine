{
  "about": "Shared design language for every 2D Heaven Sect map. A level file (levels/*.json) names its rooms, seats and exits and may override any piece here; changing a level file redraws only that level. Source art: Ninja Adventure Asset Pack by Pixel-boy and AAA, CC0 (../calrunian-dojo/src16/LICENSE-CC0.txt), 16 px tiles drawn up 2x to WorkAdventure's 32 px.",
  "src_px": 16,
  "scale": 2,
  "sheets": {
    "house": "../calrunian-dojo/src16/TilesetHouse.png",
    "nature": "../calrunian-dojo/src16/TilesetNature.png",
    "floor": "../calrunian-dojo/src16/TilesetFloor.png",
    "element": "../calrunian-dojo/src16/TilesetElement.png",
    "ifloor": "../calrunian-dojo/src16/TilesetInteriorFloor.png",
    "wall": "../calrunian-dojo/src16/TilesetWallSimple.png",
    "yun": "../calrunian-dojo/src16/MasterSheet.png",
    "motes": "@motes"
  },
  "recolor": {
    "about": "The one banner drawn in purple is redrawn in the water element's colours from public/ui/tokens.css (--ui-water-glow #1a7a8a); the aesthetic contract allows no invented purples.",
    "house_banner_violet": {"sheet": "house", "x": 27, "y": 20, "w": 1, "h": 2, "hue_to": "#1a7a8a"}
  },
  "fills": {
    "grass": {"sheet": "floor", "tiles": [[0, 12], [0, 12], [0, 12], [1, 12], [2, 12], [3, 12]]},
    "paving": {"sheet": "ifloor", "grid4": [0, 12], "about": "cobbled panels, the outdoor ground of courts, lanes and walks"},
    "boards_tan": {"sheet": "ifloor", "grid4": [11, 0], "about": "framed boards: the dojo and the founder's hall"},
    "boards_green": {"sheet": "ifloor", "grid4": [11, 6], "about": "jade boards: the tea library"},
    "brick_pale": {"sheet": "ifloor", "grid4": [0, 0], "about": "pale tile: the Elders' halls"},
    "stone_dark": {"sheet": "ifloor", "grid4": [11, 12], "about": "dark stone: the altar"},
    "medallion": {"sheet": "ifloor", "x": 15, "y": 0, "w": 4, "h": 4}
  },
  "walls": {
    "about": "Nine-slice wall rings; each room kind picks one so a room's colour says what it is.",
    "tan":    {"sheet": "wall", "ox": 0, "oy": 0},
    "orange": {"sheet": "wall", "ox": 5, "oy": 0},
    "brown":  {"sheet": "wall", "ox": 0, "oy": 6},
    "green":  {"sheet": "wall", "ox": 5, "oy": 6},
    "nine": {"tl": [0, 0], "t": [3, 0], "tr": [4, 0], "l": [0, 1], "r": [4, 1], "bl": [0, 4], "b": [3, 4], "br": [4, 4]}
  },
  "stamps": {
    "plum": {"sheet": "nature", "x": 0, "y": 18, "w": 3, "h": 3, "over_rows": 2},
    "pine": {"sheet": "nature", "x": 0, "y": 0, "w": 2, "h": 2, "over_rows": 1},
    "round_tree": {"sheet": "nature", "x": 16, "y": 0, "w": 2, "h": 2, "over_rows": 1},
    "big_tree": {"sheet": "nature", "x": 4, "y": 2, "w": 4, "h": 3, "over_rows": 2},
    "bamboo_tall": {"sheet": "nature", "x": 11, "y": 8, "w": 1, "h": 3, "over_rows": 2},
    "bamboo_short": {"sheet": "nature", "x": 12, "y": 9, "w": 1, "h": 2, "over_rows": 1},
    "scholar_rock": {"sheet": "nature", "x": 19, "y": 8, "w": 2, "h": 2, "over_rows": 0},
    "pebble_rock": {"sheet": "nature", "x": 21, "y": 9, "w": 1, "h": 1, "over_rows": 0},
    "bush": {"sheet": "nature", "x": 1, "y": 10, "w": 1, "h": 1, "over_rows": 0, "collide": false},
    "fern": {"sheet": "nature", "x": 9, "y": 10, "w": 1, "h": 1, "over_rows": 0, "collide": false},
    "cushion": {"sheet": "element", "x": 2, "y": 1, "w": 1, "h": 1, "over_rows": 0, "collide": false, "about": "a seat: walkers stand on it to sit"},
